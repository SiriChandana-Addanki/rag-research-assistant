# Copy to .env locally and set GEMINI_API_KEY outside version control.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RAG_TOP_K=5
RAG_CANDIDATE_K=10
RAG_SEMANTIC_WEIGHT=0.75
RAG_CONTEXT_LIMIT=12000
RAG_TIMEOUT=15
RAG_MAX_RETRIES=2
# Optional USD prices per million tokens; leave blank when unknown.
RAG_INPUT_COST_PER_MILLION=
RAG_OUTPUT_COST_PER_MILLION=
